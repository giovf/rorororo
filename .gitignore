*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Logs
logs
# Dependency directories
# Environment variables
# Editor directories and files
.idea
.vscode
*.ntvs*
*.njsproj
*.sln
# OS specific

# Task files
# tasks.json
# tasks/ 

# ── Python prior-art (src/, environment/) — venv and bytecode only
.venv/
__pycache__/
*.pyc

# ── Editor/AI tooling caches
.codegpt/

# ── Owner's Figma "New plugin" template (only its id matters; kept out of the repo)
docs/for-owner/actions/plugin/

# ── Obsidian vault state (owner reads docs/ in Obsidian)
docs/.obsidian/
dist-release/
ventures/*/read-focus.zip
*.zip

# ── Owner screen recordings (large); extracted PNG frames are committed
ventures/*/assets/screenshots/*.mov
ventures/*/assets/screenshots/*.mp4

# ── wrangler local cache
.wrangler/
ventures/*/assets/screenshots/Screenshot *.png
