# npm 10.9 arborist crashes (null edgesOut) on gankdat's walletconnect peer set; legacy peer resolution installs cleanly.
legacy-peer-deps=true
# Routines filtered npm's five-line "New major version of npm available" banner out of every `npm run` (2026-10-08, foundry npmrc-update-notifier-off).
update-notifier=false
