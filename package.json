{
  "name": "foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Foundry — a portfolio of small, self-funding digital products built and operated by Claude Code.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "ventures/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p scripts && tsc -p ventures/tax-workbook && tsc -p packages/landing && tsc -p ventures/variables-toolkit && tsc -p ventures/read-focus && tsc -p ventures/read-focus/e2e && tsc -p ventures/highlight-keep && tsc -p ventures/highlight-keep/e2e",
    "build": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:root && npm run check -w @foundry/gankdat",
    "check:root": "npm run typecheck && npm run portfolio && npm run ledger && npm run pipeline && npm run handoffs && npm run runs && npm run claims && npm run ci-yaml && npm run lint && npm run format:check && npm run test",
    "portfolio": "node --disable-warning=ExperimentalWarning scripts/portfolio.ts",
    "ledger": "node --disable-warning=ExperimentalWarning scripts/ledger-check.ts",
    "licensing:keygen": "node --disable-warning=ExperimentalWarning scripts/licensing-keygen.ts",
    "ops": "node --disable-warning=ExperimentalWarning scripts/ops-dashboard.ts",
    "e2e": "npm run e2e -w @foundry/read-focus && npm run e2e -w @foundry/highlight-keep",
    "cws": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/cws-publish.ts",
    "amo-listing": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/amo-listing.ts",
    "pipeline": "node --disable-warning=ExperimentalWarning scripts/pipeline.ts",
    "slot": "node --disable-warning=ExperimentalWarning scripts/slot.ts",
    "task": "node --disable-warning=ExperimentalWarning scripts/taskmaster-add.ts",
    "runner-refresh": "npm run runner-refresh -w @foundry/gankdat",
    "refresh-errors": "node --disable-warning=ExperimentalWarning scripts/refresh-errors-to-queue.ts",
    "cf-overage": "node --disable-warning=ExperimentalWarning scripts/cf-overage-to-queue.ts",
    "bounties": "node --disable-warning=ExperimentalWarning scripts/bounty-scanner.ts",
    "ops:data": "node --disable-warning=ExperimentalWarning scripts/ops-data.ts",
    "versions": "node --disable-warning=ExperimentalWarning scripts/versions-check.ts",
    "mcp-probe": "node --disable-warning=ExperimentalWarning scripts/mcp-probe.ts",
    "handoffs": "node --disable-warning=ExperimentalWarning scripts/handoffs.ts",
    "runs": "node --disable-warning=ExperimentalWarning scripts/runs-check.ts",
    "entry-imports": "node --disable-warning=ExperimentalWarning scripts/node-entry-imports.ts",
    "first-runs": "node --disable-warning=ExperimentalWarning scripts/first-runs.ts",
    "claims": "node --disable-warning=ExperimentalWarning scripts/bounty-claims.ts",
    "ci-yaml": "node --disable-warning=ExperimentalWarning scripts/ci-workflow-yaml.ts",
    "slots": "node --disable-warning=ExperimentalWarning scripts/slot-utilisation.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
