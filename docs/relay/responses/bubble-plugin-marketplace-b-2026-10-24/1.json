-plugin-have-298-installs-but-only-12-month-in-payments/276939/12","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":935637,"name":"Ankur | Nocodetalks","username":"ankur1","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/dfb087/{size}.png","created_at":"2023-09-30T13:10:06.972Z","cooked":"\u003cp\u003ePeople are constantly installing your plugin and uninstalling immediately. (or after some time).\u003c/p\u003e\n\u003cp\u003e$12 you are receiving because 5 people have subscribed to your plugin (25% bubble fees) or one person is buying every-month (You can check the detail transaction list in your account page).\u003c/p\u003e","post_number":13,"post_type":1,"posts_count":14,"updated_at":"2023-09-30T13:10:06.972Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":4,"reads":56,"readers_count":55,"score":31.2,"yours":false,"topic_id":276939,"topic_slug":"why-does-my-plugin-have-298-installs-but-only-12-month-in-payments","display_username":"Ankur | Nocodetalks","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":41515,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/why-does-my-plugin-have-298-installs-but-only-12-month-in-payments/276939/13","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false