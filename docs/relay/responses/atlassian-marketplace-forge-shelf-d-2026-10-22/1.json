68f3ce-6270-4119-a889-b0dcace4babc?width=987&height=532","type":"image/png"},"highRes":{"href":"https://marketplace.atlassian.com/product-listing/files/f668f3ce-6270-4119-a889-b0dcace4babc?width=1974&height=1064","type":"image/png"}}}},"title":"Diagrams that survive PDF and Word export","body":"<p>On save, a high-resolution PNG is stored on the page. PDF, Word, and page history show that image, not a placeholder. Download SVG or PNG from the page, or open fullscreen to zoom and pan from 25% to 400%.</p>","explanation":"Hover the diagram to open downloads, copy SVG, and fullscreen. The same image is attached to the page so PDF and Word export show the diagram, not a blank box."}],"screenshots":[],"license":{"_links":{"self":{"href":"/rest/2/licenseTypes/commercial"}},"key":"commercial","name":"Commercial"}},"buildNumber":1000030,"name":"3.0.0","status":"public","paymentModel":"atlassian","release":{"date":"2026-09-15","releasedBy":"SYSTEM","beta":false,"supported":true},"vendorLinks":{"documentation":"https://skanda-apps.atlassian.net/wiki/spaces/MDIFC/overview","license":"https://www.atlassian.com/licensing/marketplace/end-user-agreement-v1","eula":"https://docs.google.com/document/d/1WMtF9O9-IKwaQJ_qWcCjAjHpv6oRlKzZRNtKS2WpsoY/edit?usp=sharing","bonTermsSupported":true,"partnerSpecificTerms":"<p>This app is licensed under the <a class=\"external-link\" rel=\"nofollow\" href=\"https://www.atlassian.com/licensing/marketplace/end-user-agreement-v1\">Standard Agreement</a> and Skanda Atlassian Apps <a class=\"external-link\" rel=\"nofollow\" href=\"https://docs.google.com/document/d/1WMtF9O9-IKwaQJ_qWcCjAjHpv6oRlKzZRNtKS2WpsoY/edit?pli=1&tab=t.0\">Specific Terms</a>.</p>"},"compatibilities":[{"application":"confluence","hosting":{"cloud":true}}],"text":{"releaseSummary":"Payment model and required scopes changed","moreDetails":"<p>Paste Mermaid into a Confluence macro and see a live preview. Reuse one source diagram on other pages with the reference macro so edits stay in sync.</p><p>+ All Mermaid 11 types: flowcharts, sequence, ER, Gantt, class, mind maps, C4, and <a class=\"external-link\" rel=\"nofollow\" href=\"https://mermaid.js.org/\">more</a><br />+ Live Editor, Syntax validation, error highlighting & live preview<br />+ Confluence PDF/Word export support<br />+ Import public source from GitHub, GitLab, or Bitbucket<br />+ Download SVG or PNG, copy SVG, fullscreen zoom and pan (25%–400%)<br />+ Light and dark themes that follow Confluence</p><p>Published diagrams keep rendering without a subscription. A 30-day trial unlocks editing, references, downloads, fullscreen, and generating PDF/Word export images. Already-saved export images still appear in PDF and Word.</p><p>Source lives on the page and renders in the browser. URL import is public hosts only.</p><p>Support: <a class=\"external-link\" rel=\"nofollow\" href=\"mailto:support@skandaapps.com\"><b>support@skandaapps.com</b></a>— reply within two business days.</p>","releaseNotes":"<p>Required scopes changed:</p><ul class=\"alternate\" type=\"disc\"><li data-parent=\"ul\">Added: read:attachment:confluence, read:page:confluence, read:space:confluence, readonly:content.attachment:confluence, write:confluence-file, read:confluence-content.summary, read:confluence-content.all, read:confluence-space.summary, search:confluence</li></ul><p>App is now paid via Atlassian.</p>"},"static":false,"deployable":true,"deployment":{"server":false,"cloud":true,"connect":false,"autoUpdateAllowed":false,"permissions":[],"dataCenter":false},"cloud":{"appId":"ari:cloud:ecosystem::app/8c5438cd-96d4-4c5b-a10b-dd06c1f5a7fc","appEnvironmentId":"f562d20f-bf6c-412c-affb-d78a16814320","appVersionId":"a9faa27f-3722-4552-867f-5a53442ab327","appScopes":[{"_links":{"alternate":{"href":"https://confluence.atlassian.com/x/uwGJGg","type":"text/html"}},"key":"read:attachment:confluence","name":"View and download content attachments","description":"View and download attachments of a page or blogpost that yo