;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="47c05952-c14c-bb85-9a2d-675b20660e09")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,261713,e=>{"use strict";e.i(979004);var a=e.i(89940),t=e.i(151681);a.V.USE_CASE,a.V.INDUSTRY,a.V.DOMAIN,a.V.OUTPUT,a.V.LABEL;let i={OTHER:{metaLabelId:t.r.OTHER,description:"Actors that haven't fit into any other category.",icon:"category"},GENERATE_LEADS:{metaLabelId:t.r.GENERATE_LEADS,description:"Actors that extract contact information, business data, or potential customer details from websites, social media, directories, or business platforms. Includes scraping emails, phone numbers, company profiles, finding users expressing buying intent or seeking recommendations, and lead enrichment tools.",displayDescription:"Find contact details, company profiles, and business data from websites, social platforms, and directories.",icon:"target"},RESEARCH_MARKETS_AND_COMPETITORS:{metaLabelId:t.r.RESEARCH_MARKETS_AND_COMPETITORS,description:"Actors that gather market intelligence, pricing data, product catalogs, reviews, and business insights. Includes market research to identify customer needs, test new product ideas, and analyze discussions in communities.",displayDescription:"Research pricing data, product catalogs, reviews, and competitor insights from across the web.",icon:"binoculars"},TRACK_COMPETITORS:{metaLabelId:t.r.TRACK_COMPETITORS,description:"Actors that monitor competitors' content, posting frequency, ad campaigns, messaging, creatives, targeting trends, and performance metrics. Includes tracking what competitors post, how often, and how well their content performs across platforms.",icon:"eye"},TRACK_TRENDS:{metaLabelId:t.r.TRACK_TRENDS,description:"Actors that monitor trending topics, viral content, emerging discussions, and popular questions within target audiences. Helps identify what products, topics, or questions are gaining traction in specific niches or communities.",icon:"trending_up"},BRAND_MONITORING:{metaLabelId:t.r.BRAND_MONITORING,description:"Actors that monitor brand mentions, reputation, ratings, reviews, and recommendations across platforms. Includes tracking brand perception over time, detecting praise or complaints, identifying PR issues from negative reactions, and monitoring when logos or brand visuals appear in content.",displayDescription:"Track mentions, reviews, ratings, and sentiment about your brand across social media and review sites.",icon:"badge"},ANALYZE_SENTIMENT:{metaLabelId:t.r.ANALYZE_SENTIMENT,description:"Actors that analyze tone, emotions, and engagement in comments, reviews, and posts to understand audience reactions. Includes detecting patterns in sentiment (support, skepticism, confusion) and gauging public reaction to campaigns or announcements.",icon:"mood_smile"},ANALYZE_SEO_AND_MARKETING:{metaLabelId:t.r.ANALYZE_SEO_AND_MARKETING,description:"Actors that collect SEO metrics, search rankings, backlinks, keywords, website performance data, and digital marketing analytics. Includes tools for website audits, organic search analysis, SERP tracking, and online visibility monitoring.",displayDescription:"Collect search rankings, backlinks, and keyword data from search engines and digital marketing tools.",icon:"chart_line"},ANALYZE_BACKLINKS:{metaLabelId:t.r.ANALYZE_BACKLINKS,description:"Actors specifically designed to crawl and analyze backlinks, inbound links, link quality, domain authority, and referral traffic. Used for SEO audits, link building strategies, and competitor backlink research.",icon:"link"},RUN_WEBSITE_AUDITS:{metaLabelId:t.r.RUN_WEBSITE_AUDITS,description:"Actors that perform technical website audits including checking for broken links, analyzing site structure, validating HTML/CSS, assessing page speed, checking mobile-friendliness, and identifying SEO technical issues.",icon:"report_search"},TRACK_PRODUCTS_AND_PRICES:{metaLabelId:t.r.TRACK_PRODUCTS_AND_PRICES,description:"Actors that track product availability, price changes, inventory levels, product reviews, ratings, and specifications across e-commerce sites and marketplaces. Includes stock monitoring, price tracking, restock alerts, product listing updates, extracting product catalogs, SKUs, specifications, and pricing data. Enables price monitoring, assortment analysis, MAP compliance, competitive pricing strategy, and product-level market intelligence across retailers and platforms.",displayDescription:"Track availability, pricing, inventory levels, and reviews across e-commerce sites and marketplaces.",icon:"shopping_cart"},COLLECT_AND_DISTRIBUTE_CONTENT:{metaLabelId:t.r.COLLECT_AND_DISTRIBUTE_CONTENT,description:"Actors that collect and aggregate content from various sources for apps, websites, newsletters, or directories. Includes gathering events, reviews, posts, articles, building databases, and feeding content platforms.",displayDescription:"Collect articles, posts, events, and media from across the web. Feed them into apps, websites, or newsletters.",icon:"archive"},MAP_BUSINESSES_BY_TYPE_AND_LOCATION:{metaLabelId:t.r.MAP_BUSINESSES_BY_TYPE_AND_LOCATION,description:"Actors that identify, categorize, and classify businesses, pages, or entities by niche, location, industry, or company type. Used for market landscape analysis and understanding market density and regional presence.",icon:"map_pin"},DEVELOPER_TOOLS:{metaLabelId:t.r.DEVELOPER_TOOLS,description:"Actors designed for technical use cases including API testing, data processing, web automation workflows, integration utilities, debugging tools, and development/testing helpers. Built for developers and technical users.",displayDescription:"Build data pipelines, automate workflows, and connect APIs.",icon:"code"},MONITOR_AND_ALERT_ON_WEBSITE_CHANGES:{metaLabelId:t.r.MONITOR_AND_ALERT_ON_WEBSITE_CHANGES,description:"Actors that continuously monitor websites for technical changes, send alerts, detect specific conditions, track content updates, monitor service uptime, and trigger notifications. Focused on technical monitoring rather than brand/reputation monitoring.",icon:"bell"},TRANSFORM_AND_PROCESS_DATA:{metaLabelId:t.r.TRANSFORM_AND_PROCESS_DATA,description:"Actors that convert, format, clean, merge, validate, or restructure data between different formats (JSON, CSV, XML, etc.). Includes data processing pipelines, format converters, data enrichment, and transformation utilities.",icon:"transform"},BUILD_FEEDS_AND_DIRECTORIES:{metaLabelId:t.r.BUILD_FEEDS_AND_DIRECTORIES,description:"Aggregate and normalize incoming content into consumable feeds, directories, or APIs (for websites, newsletters, or apps). Users aim to discover, merge, deduplicate and publish up‑to‑date lists of items (articles, events, listings, courses, etc.) that drive front‑end catalogs, email digests or public endpoints.",icon:"list_tree"},BUILD_AI_TRAINING_DATA:{metaLabelId:t.r.BUILD_AI_TRAINING_DATA,description:"Collect, clean and transform large volumes of text and documents to build searchable knowledge bases, training corpora, or RAG inputs for LLMs. The goal is to produce cleaned, chunked, labeled content (with provenance) suitable for semantic search, model fine‑tuning, or retrieval pipelines.",icon:"brain"},SCRAPE_FORUMS_AND_COMMUNITY_DISCUSSIONS:{metaLabelId:t.r.SCRAPE_FORUMS_AND_COMMUNITY_DISCUSSIONS,description:"Extract threads, posts, comments, Q&A content, and discussion metadata from forums, community platforms, and discussion boards such as Reddit, Quora, Stack Overflow, Slack, Discord, and niche community sites. Build conversational knowledge bases, community-sourced training datasets, and threaded discussion archives with upvotes, replies, and author context.",icon:"messages"},EXTRACT_VIDEO_TRANSCRIPTS_AND_CAPTIONS:{metaLabelId:t.r.EXTRACT_VIDEO_TRANSCRIPTS_AND_CAPTIONS,description:"Extract, download, and process transcripts, subtitles, and captions from video platforms such as YouTube, TikTok, Instagram, Facebook, and Loom. Produces clean text with timestamps suitable for search indexes, LLM training corpora, content repurposing, or downstream summarization and analysis.",icon:"subtitles"},COLLECT_ACADEMIC_PAPERS:{metaLabelId:t.r.COLLECT_ACADEMIC_PAPERS,description:"Collect metadata, abstracts, citations, and full-text content from academic databases, preprint servers, and scholarly repositories such as arXiv, PubMed, Google Scholar, Semantic Scholar, and OpenAlex. Build research corpora, citation graphs, and literature review datasets for scientific research and analysis.",icon:"school"},CONVERT_WEB_PAGES_TO_AI_READY_TEXT:{metaLabelId:t.r.CONVERT_WEB_PAGES_TO_AI_READY_TEXT,description:"Crawl and convert web pages, documentation sites, blogs, and online articles into clean markdown, plain text, or structured formats optimized for LLM context windows, RAG pipelines, and fine-tuning datasets. Focused on collecting and cleaning web content for AI consumption rather than general-purpose scraping.",icon:"world_www"},DOWNLOAD_AND_ARCHIVE_MEDIA:{metaLabelId:t.r.DOWNLOAD_AND_ARCHIVE_MEDIA,description:"Harvest media assets (images, audio, video) together with rich metadata for catalogs, archives, or ML datasets. Users want reliable bulk download, format/quality selection, metadata pairing, and storage/export workflows to build libraries, training datasets, or long‑term archives.",icon:"download"},GET_DEAL_AND_RESTOCK_ALERTS:{metaLabelId:t.r.GET_DEAL_AND_RESTOCK_ALERTS,description:"Find time-sensitive opportunities — price drops, limited deals, flash sales, and restocks — and notify users (or downstream workflows) of actionable events. Focused on short‑term opportunity detection for resellers, bargain hunters, and procurement teams.",icon:"discount"},TRACK_FINANCIAL_MARKETS_AND_TRADING_DATA:{metaLabelId:t.r.TRACK_FINANCIAL_MARKETS_AND_TRADING_DATA,description:"Collect time-series prices, order-book snapshots, trader/leaderboard signals, economic-calendar events, and other market data to build trading signals, backtests, alerts, or quantitative research pipelines. Goal: obtain timely market and instrument-level inputs for trading, portfolio analysis, or financial research.",icon:"chart_candle"},PROFILE_COMPANIES_AND_DUE_DILIGENCE:{metaLabelId:t.r.PROFILE_COMPANIES_AND_DUE_DILIGENCE,description:"Aggregate firmographic, funding, financial, ownership, and reputational signals (profiles, disclosures, filings, analyst/registry data) to evaluate companies for M&A, vendor validation, supplier research, credit checks, or investment screening. Goal: produce enriched company dossiers to support decisions that require corporate background and risk assessment.",icon:"building_skyscraper"},ENRICH_COMPANY_PROFILES:{metaLabelId:t.r.ENRICH_COMPANY_PROFILES,description:"Aggregate firmographic data — industry, company size, headquarters, key personnel, descriptions, and organizational structure — from LinkedIn company pages, business intelligence platforms like ZoomInfo and Dun & Bradstreet, and professional networks. Build enriched company profiles for sales targeting, due diligence, competitive research, and CRM enrichment.",icon:"briefcase"},GET_COMPANY_REGISTRIES_AND_FILINGS:{metaLabelId:t.r.GET_COMPANY_REGISTRIES_AND_FILINGS,description:"Retrieve corporate registration records, legal entity data, ownership structures, director information, insolvency filings, and litigation records from government registries and public databases such as Companies House, SEC EDGAR, Handelsregister, and OpenCorporates. Verify company existence, legal standing, and shareholder structures for KYC, compliance, and due diligence workflows.",icon:"certificate"},RESEARCH_B2B_SUPPLIERS_AND_TRADE_PARTNERS:{metaLabelId:t.r.RESEARCH_B2B_SUPPLIERS_AND_TRADE_PARTNERS,description:"Profile industrial suppliers, manufacturers, wholesalers, and trade partners from B2B marketplaces, trade directories, and exhibitor lists such as Alibaba, ThomasNet, and industry trade shows. Support procurement decisions, supply chain due diligence, and partner discovery by extracting supplier catalogs, certifications, capacity, MOQs, and reliability signals.",icon:"truck"},RESEARCH_FUNDING_AND_FINANCIALS:{metaLabelId:t.r.RESEARCH_FUNDING_AND_FINANCIALS,description:"Collect funding rounds, investor details, financial disclosures, revenue estimates, and investment signals from platforms like Crunchbase, PitchBook, and SEC EDGAR. Support investment screening, credit checks, M&A evaluation, and competitive financial analysis by assembling funding histories, cap table signals, and public financial filings.",icon:"coins"},CHECK_COMPLIANCE_AND_ESG:{metaLabelId:t.r.CHECK_COMPLIANCE_AND_ESG,description:"Screen companies against sanctions lists, verify professional licenses and permits, collect trust scores and accreditation status from BBB and similar bodies, and gather ESG disclosures, sustainability reports, and carbon footprint data. Support KYC, vendor validation, responsible investment screening, and regulatory compliance checks by consolidating compliance, trust, and sustainability signals from government databases, accreditation bodies, and ESG data providers.",icon:"shield_check"},DISCOVER_STARTUPS_AND_NEW_LAUNCHES:{metaLabelId:t.r.DISCOVER_STARTUPS_AND_NEW_LAUNCHES,description:"Continuously discover and monitor early-stage product launches, crowdfunding campaigns, accelerator/launch platforms and Product Hunt-style entries to surface emerging products, founders, or investable/sourcable opportunities. Goal: find high-potential launches, campaign momentum, and deal leads for scouting, incubation, or partnership pipelines.",icon:"rocket"},BUILD_B2B_PROSPECT_LISTS:{metaLabelId:t.r.BUILD_B2B_PROSPECT_LISTS,description:"Help sales, SDR and marketing teams assemble targeted business prospect lists and enrich them for outreach — e.g., find companies and decision‑makers, firmographics (size, industry), work emails and phone numbers, and merge/validate records for account‑based or outbound campaigns.",icon:"address_book"},LOCAL_BUSINESS_PROSPECTING:{metaLabelId:t.r.LOCAL_BUSINESS_PROSPECTING,description:"Help users discover and qualify nearby SMBs and place-based leads for local outreach — e.g., compile geographically scoped lists of shops, restaurants, clinics or service providers with addresses, phones, websites, opening hours and website‑sourced emails for local marketing or field sales.",icon:"building_store"},INFLUENCER_AND_CREATOR_OUTREACH:{metaLabelId:t.r.INFLUENCER_AND_CREATOR_OUTREACH,description:"Support influencer marketing and creator partnerships by finding and qualifying creators (YouTube, Instagram, TikTok, etc.), extracting contact channels, audience/engagement signals, and contextual profile info to build outreach lists for sponsorships, UGC, PR or collaborations.",icon:"megaphone"},SPOT_VIRAL_CONTENT_AND_CREATORS:{metaLabelId:t.r.SPOT_VIRAL_CONTENT_AND_CREATORS,description:"Identify breakout content, formats, sounds, hashtags and the creators driving them so teams can source examples, shortlist influencers, and copy successful creative patterns for content strategy or partnerships.",icon:"flame"},RESEARCH_KEYWORDS_AND_SEARCH_DEMAND:{metaLabelId:t.r.RESEARCH_KEYWORDS_AND_SEARCH_DEMAND,description:"Uncover high‑intent search phrases, autocomplete suggestions, long‑tail keywords and query trends to guide SEO/PPC, product-market research, content ideation, and keyword-driven opportunity scoring.",icon:"hash"},TRACK_TOPICS_AND_MARKET_SHIFTS:{metaLabelId:t.r.TRACK_TOPICS_AND_MARKET_SHIFTS,description:"Continuously track emerging topics, news coverage, community signals and sentiment across sources to detect market shifts, PR risks, product launches, or research trends for competitive intelligence and decision making.",icon:"rss"},BROWSER_AUTOMATION:{metaLabelId:t.r.BROWSER_AUTOMATION,description:"Actors that automate browser interactions, perform web testing, simulate user behavior, handle authentication and sessions, and execute automated workflows. Includes testing frameworks, interaction utilities, and session management tools.",icon:"browser"},AI_INTEGRATIONS:{metaLabelId:t.r.AI_INTEGRATIONS,description:"Actors that integrate with AI services, LLMs, and agent frameworks including Model Context Protocol (MCP) servers, AI-powered scraping tools, and AI assistant connectors. Built for developers working with AI/ML workflows.",icon:"input_ai"},PROCESS_AND_CONVERT_MEDIA:{metaLabelId:t.r.PROCESS_AND_CONVERT_MEDIA,description:"Actors that process, convert, manipulate, or analyze media files including images, videos, audio, and documents. Includes format converters, computer vision tools, screenshot utilities, and visual capture tools.",icon:"wand"},ORCHESTRATE_WORKFLOWS_AND_AUTOMATION:{metaLabelId:t.r.ORCHESTRATE_WORKFLOWS_AND_AUTOMATION,description:"Actors that orchestrate multi-step workflows, manage actor runs, coordinate automation pipelines, and handle task scheduling. Focused on workflow management and process automation for developers.",icon:"arrows_exchange"},TRACK_SEARCH_RANKINGS:{metaLabelId:t.r.TRACK_SEARCH_RANKINGS,description:"Actors that scrape search engine results pages (SERPs) from Google, Bing, and other search engines and monitor keyword ranking positions over time. Extract organic results, paid ads, featured snippets, knowledge panels, local packs, and related searches to support SEO strategy, competitive positioning, and search visibility analysis.",icon:"chart_bar"},ANALYZE_DOMAIN_AUTHORITY:{metaLabelId:t.r.ANALYZE_DOMAIN_AUTHORITY,description:"Actors that analyze domain-level SEO metrics including domain authority, PageRank, trust scores, traffic estimates, domain age, DNS records, and hosting information. Supports competitive domain comparison, link prospect qualification, and domain portfolio evaluation.",icon:"award"},EXTRACT_WEBSITE_METADATA:{metaLabelId:t.r.EXTRACT_WEBSITE_METADATA,description:"Actors that extract website metadata, Open Graph tags, schema markup, structured data, technology stacks, CMS detection, and page-level technical attributes. Supports competitive tech intelligence, content optimization, and large-scale website profiling.",icon:"table_export"},COLLECT_NEWS_AND_ARTICLES:{metaLabelId:t.r.COLLECT_NEWS_AND_ARTICLES,description:"Aggregate news articles, headlines, authors, and publication metadata from news sites, blogs, and media outlets. Users build media monitoring dashboards, track coverage of topics or brands, analyze news sentiment, create content feeds, and compile press archives for PR, research, and competitive intelligence.",icon:"news"},COLLECT_AND_ANALYZE_CUSTOMER_REVIEWS:{metaLabelId:t.r.COLLECT_AND_ANALYZE_CUSTOMER_REVIEWS,description:"Extract, aggregate, and analyze customer reviews, ratings, and feedback from e-commerce platforms, review sites, and app stores to understand product perception, satisfaction drivers, feature requests, and sentiment patterns. Goal: build structured review datasets for product improvement, competitive benchmarking, and voice-of-customer research.",icon:"message_circle_star"},RESEARCH_APP_STORES_AND_SOFTWARE_MARKETS:{metaLabelId:t.r.RESEARCH_APP_STORES_AND_SOFTWARE_MARKETS,description:"Scrape app store listings, rankings, download estimates, pricing, and metadata from mobile app stores and software marketplaces to analyze category performance, competitor apps, feature gaps, and market opportunities. Includes SaaS and B2B software landscape research. Goal: produce app-level and category-level intelligence for product strategy, competitive analysis, and market entry decisions.",icon:"apps"},EMAIL_PHONE_EXTRACTION:{metaLabelId:t.r.EMAIL_PHONE_EXTRACTION,description:"Extract, discover and normalize contact details (emails, phone numbers, mobile numbers) from websites, directories, social profiles or business listings. Goal: harvest raw contact data from public sources and format it for outreach or list building, often as a foundational step before enrichment or validation.",icon:"at"},PRODUCT_SOURCING_AND_PROCUREMENT:{metaLabelId:t.r.PRODUCT_SOURCING_AND_PROCUREMENT,description:"Help buyers, merchandisers and procurement teams find and evaluate suppliers and wholesale offers: discover supplier catalogs, compare wholesale pricing and MOQs, validate supplier reliability, collect product specs and lead times, and calculate expected margins to decide whether to source or list an item.",icon:"truck_delivery"},FIND_RESALE_AND_ARBITRAGE_DEALS:{metaLabelId:t.r.FIND_RESALE_AND_ARBITRAGE_DEALS,description:"Find buy‑now resale opportunities across marketplaces and auction platforms: continuously scan listings, flash sales, restocks and auction lots to surface underpriced, mis‑priced or soon-to-be-sold items, estimate flip/profit potential, and deliver deal signals for resellers and flippers.",icon:"tag_starred"},BUILD_MARKET_DATASETS:{metaLabelId:t.r.BUILD_MARKET_DATASETS,description:"Assemble normalized, analyzable market-level datasets (inventories, counts, price distributions, availability snapshots and time series) across many listings or sources so teams can do market sizing, category analysis, trend reporting and BI. The goal is to convert many raw listings into aggregated, comparable metrics and feeds for decision‑making.",icon:"database"},FIND_DEALS_AND_BUY_OPPORTUNITIES:{metaLabelId:t.r.FIND_DEALS_AND_BUY_OPPORTUNITIES,description:"Continuously discover and surface actionable buy/sourcing opportunities (auctions, business‑for‑sale listings, limited drops, resale arbitrage signals, crowdfunding momentum) so buyers, resellers and investors can act — i.e., find deals, evaluate leads and prioritize targets for acquisition or resale.",icon:"cash"},FIND_AND_ENRICH_CREATOR_CONTACTS:{metaLabelId:t.r.FIND_AND_ENRICH_CREATOR_CONTACTS,description:"Help users assemble outreach-ready creator lists by finding and validating contact channels (emails, phone numbers, link-in-bio targets), deduplicating and normalizing contacts, and enriching each prospect with audience and contextual signals so lists are immediately usable for outreach or CRM import.",icon:"user_search"},DISCOVER_AND_PROFILE_CREATORS:{metaLabelId:t.r.DISCOVER_AND_PROFILE_CREATORS,description:"Find and profile creators matching target criteria by scraping profile metadata, follower counts, engagement rates, bios, category labels, and growth metrics from social platforms. Build creator prospect lists by searching keywords, hashtags, niches, and location tags to surface relevant accounts for influencer campaigns.",icon:"user_star"},ANALYZE_CREATOR_CONTENT_ENGAGEMENT:{metaLabelId:t.r.ANALYZE_CREATOR_CONTENT_ENGAGEMENT,description:"Extract and analyze creator content performance data — post metadata, captions, hashtags, view/like/comment counts, audience interactions, and engagement signals — to evaluate content quality, identify high-performing formats, measure authentic engagement depth, and inform partnership decisions.",icon:"chart_dots"},VET_AND_SCORE_CREATORS:{metaLabelId:t.r.VET_AND_SCORE_CREATORS,description:"Provide evaluation and qualification workflows that assess creators for campaign fit — e.g., compute engagement rates, detect audience authenticity/fake followers, flag brand-safety issues, and produce ranked fit scores and qualitative summaries to shortlist creators for partnerships.",icon:"user_check"},AUTOMATE_INFLUENCER_OUTREACH:{metaLabelId:t.r.AUTOMATE_INFLUENCER_OUTREACH,description:"Enable end-to-end outreach operations: schedule and send personalized outreach at scale (DMs, emails), manage multi-account rotation and rate controls, track delivery/status, and produce per-campaign reporting and exports for running and monitoring influencer outreach campaigns.",icon:"speakerphone"},DISCOVER_LEADS_FROM_ENGAGEMENTS:{metaLabelId:t.r.DISCOVER_LEADS_FROM_ENGAGEMENTS,description:"Find and qualify prospects by harvesting people who engaged with specific content (post likers, commenters, event attendees, review authors). Goal: surface warm, contextually relevant leads based on their interaction behaviour so outreach is more targeted and timely.",icon:"user_plus"},LEAD_ENRICHMENT_AND_VALIDATION:{metaLabelId:t.r.LEAD_ENRICHMENT_AND_VALIDATION,description:"Enrich, verify and normalize existing prospect lists (append emails/phones/socials, deduplicate, validate deliverability, format phone numbers). Goal: improve lead quality and readiness for outreach or CRM ingestion rather than discovering raw leads.",icon:"list_check"},AUTOMATE_OUTREACH_CAMPAIGNS:{metaLabelId:t.r.AUTOMATE_OUTREACH_CAMPAIGNS,description:"Automate sending personalized outreach at scale (connection requests, DMs, bulk messages, scheduled campaigns) and manage basic send controls (throttling, templates, resume). Goal: convert discovered leads by executing and operationalizing outreach sequences safely and at volume.",icon:"send"},BUILD_LARGE_PROSPECT_DATABASES:{metaLabelId:t.r.BUILD_LARGE_PROSPECT_DATABASES,description:"Assemble very large, exportable prospect databases for mass outbound campaigns or data products. Users want to pull thousands-to-millions of records (companies or contacts), apply broad filters (industry, geography, title), enrich with deliverable emails/phones and firmographics, deduplicate and export in CRM-ready formats for high-throughput marketing, list rental, or recurring refresh workflows.",icon:"database_plus"},IDENTIFY_DECISION_MAKERS:{metaLabelId:t.r.IDENTIFY_DECISION_MAKERS,description:"Find and qualify the right people at named accounts for personalized outreach. Users want to map org charts, identify decision‑makers or role‑specific contacts (titles, seniority, department), enrich individual records with context (company signals, recent activity, hiring/events), and produce small-to-medium sized, high‑precision lists for ABM, SDR outreach or tailored recruiting approaches.",icon:"crown"},TRACK_ONLINE_CONVERSATIONS_AND_ENGAGEMENT:{metaLabelId:t.r.TRACK_ONLINE_CONVERSATIONS_AND_ENGAGEMENT,description:"Collect posts, comments, replies, mentions, tagged content, hashtag discussions, and audience metrics from social and web platforms to monitor how brands are discussed, how audiences react to brand content, and how brand presence and engagement evolve over time. Covers scraping timelines, comment threads, mention/tag feeds, follower counts, and engagement rates for reputation tracking and competitive social benchmarking.",icon:"message_2"},MONITOR_HASHTAG_AND_KEYWORD_MENTIONS:{metaLabelId:t.r.MONITOR_HASHTAG_AND_KEYWORD_MENTIONS,description:"Track brand mentions, hashtags, tagged content, and keyword conversations across social media and the web to surface where and how often a brand or topic appears. Includes monitoring mention volume, context, and reach to detect PR risks, track campaign spread, and identify organic brand advocacy or complaints.",icon:"device_analytics"},COLLECT_REVIEWS_AND_RATINGS:{metaLabelId:t.r.COLLECT_REVIEWS_AND_RATINGS,description:"Scrape customer reviews, star ratings, reviewer details, and review metadata from review platforms and business listing sites to track brand reputation and customer satisfaction. Covers Trustpilot, Google Maps, Tripadvisor, App Store, Google Play, Booking, Airbnb, Facebook, Yelp, G2, Capterra, and similar platforms where customers leave public feedback about products, services, or businesses.",icon:"star_empty"},CONVERT_BETWEEN_DATA_FORMATS:{metaLabelId:t.r.CONVERT_BETWEEN_DATA_FORMATS,description:"Convert and restructure data between formats such as JSON, CSV, XML, YAML, Excel, PDF, HTML, and Markdown. Includes document parsing, format transformation, serialization, schema mapping, and content extraction from PDFs and other document types into usable structured or text formats.",icon:"arrows_right_left"},CLEAN_VALIDATE_AND_DEDUPLICATE_DATASETS:{metaLabelId:t.r.CLEAN_VALIDATE_AND_DEDUPLICATE_DATASETS,description:"Clean, normalize, validate, deduplicate, compare, and diff datasets to improve data quality. Includes record matching, duplicate removal, field normalization, dataset merging, sorting, and data quality checks for downstream processing.",icon:"filter"},EXPORT_AND_SYNC_DATA_TO_EXTERNAL_STORAGE:{metaLabelId:t.r.EXPORT_AND_SYNC_DATA_TO_EXTERNAL_STORAGE,description:"Export, push, and synchronize scraped or processed data to external databases, cloud storage, spreadsheets, APIs, and data warehouses. Covers integrations with Google Sheets, Airtable, S3, MongoDB, PostgreSQL, and similar targets to move data out of Apify into operational systems.",icon:"cloud_upload"},VALIDATE_AND_RESOLVE_IDENTIFIERS:{metaLabelId:t.r.VALIDATE_AND_RESOLVE_IDENTIFIERS,description:"Validate, verify, decode, and look up identifiers, credentials, and location data. Covers email validation, phone number parsing, VAT/tax ID checks, VIN decoding, barcode lookups, IP geolocation, address geocoding, and other structured identifier resolution and enrichment.",icon:"scan"},PREPARE_DATA_FOR_LLM_AND_RAG:{metaLabelId:t.r.PREPARE_DATA_FOR_LLM_AND_RAG,description:"Chunk, embed, vectorize, and format already-collected content for use in large language model applications, retrieval-augmented generation systems, and AI training datasets. Focused on the transformation step — converting raw text and documents into LLM-ready inputs such as vector embeddings, chunked passages, and structured training examples.",icon:"activity"},GENERATE_SYNTHETIC_AND_MOCK_DATA:{metaLabelId:t.r.GENERATE_SYNTHETIC_AND_MOCK_DATA,description:"Generate synthetic datasets, mock records, fake test fixtures, and dummy data for development, testing, QA, and data augmentation. Includes random data generation, hash/encoding utilities, and tools that produce realistic but artificial data.",icon:"file_database"},EXTRACT_VEHICLE_LISTINGS_AND_AUTOMOTIVE_DATA:{metaLabelId:t.r.EXTRACT_VEHICLE_LISTINGS_AND_AUTOMOTIVE_DATA,description:"Actors that extract vehicle listings, specifications, pricing, and dealer information from automotive marketplaces, as well as auto parts catalogs with fitment and compatibility data. Covers cars, motorcycles, trucks, and specialty vehicles across dealership platforms and classified auto markets.",icon:"car_suv"},SCRAPE_GROCERY_PRICES_AND_FOOD_DELIVERY_MENUS:{metaLabelId:t.r.SCRAPE_GROCERY_PRICES_AND_FOOD_DELIVERY_MENUS,description:"Actors that extract product pricing, availability, and promotions from supermarket chains and grocery platforms, as well as restaurant menus, item pricing, and delivery fees from food delivery services. Supports CPG competitive pricing analysis, grocery price index tracking, and food delivery market intelligence.",icon:"salad"},EXTRACT_TRAVEL_AND_HOSPITALITY_PRICING:{metaLabelId:t.r.EXTRACT_TRAVEL_AND_HOSPITALITY_PRICING,description:"Actors that extract hotel rates, room availability, flight pricing, car rental listings, and tour/experience pricing from travel booking platforms and OTAs. Enables rate intelligence for revenue management, competitive benchmarking across booking channels, and travel market analysis.",icon:"plane"},SCRAPE_CLASSIFIEDS_AND_P2P_MARKETPLACE_LISTINGS:{metaLabelId:t.r.SCRAPE_CLASSIFIEDS_AND_P2P_MARKETPLACE_LISTINGS,description:"Actors that extract product listings, seller details, and pricing from classified ad platforms and peer-to-peer marketplaces where individuals sell new or used goods. Covers general classifieds, secondhand fashion, local buy-sell platforms, and community marketplaces for market research and catalog building.",icon:"tag"},SOCIAL_MEDIA:{metaLabelId:t.r.SOCIAL_MEDIA,description:"Actors targeting social media platforms such as Facebook, Instagram, Twitter/X, TikTok, LinkedIn, YouTube, Reddit, Pinterest, and Threads. Includes extracting posts, profiles, comments, followers, hashtags, and engagement data from social networks.",displayDescription:"Actors to find you posts, profiles, comments, and likes from Facebook, Instagram, Twitter/X, TikTok, Reddit, and more.",icon:"social"},ECOMMERCE:{metaLabelId:t.r.ECOMMERCE,description:"Actors targeting online shopping platforms such as Amazon, eBay, Shopify stores, AliExpress, Walmart, Etsy, and similar marketplaces. Includes extracting product listings, prices, reviews, seller information, and inventory data.",displayDescription:"Actors to find you product prices, stock levels, reviews, and listings from Amazon, eBay, Etsy, Walmart, and more.",icon:"shopping_bag"},TRAVEL_AND_HOSPITALITY:{metaLabelId:t.r.TRAVEL_AND_HOSPITALITY,description:"Actors targeting travel and hospitality platforms such as Booking.com, Airbnb, Tripadvisor, Expedia, Google Hotels, and airline websites. Includes extracting hotel listings, flight prices, reviews, availability, and travel deals.",displayDescription:"Actors to find you hotel rates, flight prices, reviews, and deals from Booking.com, Airbnb, Expedia, Tripadvisor, and more.",icon:"luggage"},REAL_ESTATE:{metaLabelId:t.r.REAL_ESTATE,description:"Actors targeting real estate platforms such as Zillow, Realtor.com, Rightmove, Zoopla, Redfin, and similar property listing sites. Includes extracting property listings, prices, agent contacts, and market data.",displayDescription:"Actors to find you home listings, prices, agent details, and market data from Zillow, Realtor.com, Redfin, and more.",icon:"building_estate"},JOB_PLATFORMS:{metaLabelId:t.r.JOB_PLATFORMS,description:"Actors targeting job boards and recruitment platforms such as LinkedIn Jobs, Indeed, Glassdoor, Monster, and company career pages. Includes extracting job postings, salary data, company reviews, and candidate profiles.",displayDescription:"Actors to find you job posts, salaries, reviews, and candidate profiles from LinkedIn, Indeed, Glassdoor, and more.",icon:"clipboard_list",enhancedTitle:"Extract job platform data"},NEWS_AND_ARTICLES:{metaLabelId:t.r.NEWS_AND_ARTICLES,description:"Actors targeting news sites, blogs, forums, and article-based platforms such as Google News, Medium, Hacker News, and news aggregators. Includes extracting articles, headlines, publication dates, authors, and comments.",displayDescription:"Actors to find you articles, headlines, authors, and comments from Google News, Medium, Hacker News, and more.",icon:"writing",enhancedTitle:"Extract news & articles"},MAPS_AND_LOCAL_BUSINESSES:{metaLabelId:t.r.MAPS_AND_LOCAL_BUSINESSES,description:"Actors targeting mapping services, local business directories, and location-based platforms such as Google Maps, Yelp, Yellow Pages, Google Business Profile, 2GIS, Angi, Thumbtack, Foursquare, and regional directory equivalents. Includes extracting business profiles, reviews, addresses, phone numbers, opening hours, and local leads.",displayDescription:"Actors to find you business profiles, reviews, phone numbers, and addresses from Google Maps, Yelp, Yellow Pages, and more.",icon:"map",enhancedTitle:"Extract maps & local business data"},B2B_AND_COMPANY_DATA:{metaLabelId:t.r.B2B_AND_COMPANY_DATA,description:"Actors targeting business databases, company registries, and sales intelligence platforms such as Crunchbase, ZoomInfo, Apollo.io, Clutch.co, Clearbit, Wellfound, Europages, Pitchbook, and Companies House. Includes extracting company profiles, firmographics, funding data, employee counts, and B2B lead information.",displayDescription:"Actors to find you company profiles, funding, and B2B leads from Crunchbase, ZoomInfo, and more.",icon:"buildings",enhancedTitle:"Extract B2B & company data"},SEARCH_ENGINES_AND_SEO:{metaLabelId:t.r.SEARCH_ENGINES_AND_SEO,description:"Actors targeting search engine results pages and SEO data platforms such as Google Search, Bing, DuckDuckGo, Baidu, Yandex, Google Trends, Ahrefs, Semrush, Moz, and Similarweb. Includes extracting SERP results, keyword rankings, backlink data, domain metrics, and search analytics.",displayDescription:"Actors to find you search results, keyword ranks, backlinks, and metrics from Google, Ahrefs, Semrush, and more.",icon:"compass",enhancedTitle:"Extract search engine & SEO data"},FINANCE_AND_CRYPTO:{metaLabelId:t.r.FINANCE_AND_CRYPTO,description:"Actors targeting financial data platforms, cryptocurrency exchanges, DeFi protocols, and market intelligence sites such as Yahoo Finance, CoinMarketCap, CoinGecko, Binance, DexScreener, Finviz, TradingView, Pump.fun, Polymarket, Investing.com, and SEC EDGAR. Includes extracting stock prices, crypto token data, trading volumes, financial filings, and prediction market odds.",displayDescription:"Actors to find you stock prices, crypto data, and filings from Yahoo Finance, CoinMarketCap, Binance, TradingView, and more.",icon:"receipt_dollar"},REVIEW_SITES:{metaLabelId:t.r.REVIEW_SITES,description:"Actors targeting dedicated review aggregation and product/software comparison platforms such as Trustpilot, G2, Capterra, TrustRadius, GoodFirms, Sitejabber, ConsumerAffairs, Kununu, and Feefo. Covers platforms whose primary function is collecting and displaying user reviews and ratings, distinct from reviews embedded within ecommerce or travel sites.",displayDescription:"Actors to find you reviews, ratings, and feedback from Trustpilot, G2, Capterra, and more.",icon:"star_full",enhancedTitle:"Extract review data"},AI_AND_ML:{metaLabelId:t.r.AI_AND_ML,description:"Actors targeting AI model hubs, machine learning tool directories, and AI integration infrastructure such as Hugging Face, Civitai, GPT Store, Ollama, RunPod, and MCP (Model Context Protocol) server directories. Includes extracting model metadata, dataset listings, and AI tool catalogs, as well as MCP servers that bridge external data sources to AI assistants.",displayDescription:"Actors to find you model details, datasets, and AI tools from Hugging Face, Civitai, GPT Store, MCP directories, and more.",icon:"cpu",enhancedTitle:null},ENTERTAINMENT_AND_STREAMING:{metaLabelId:t.r.ENTERTAINMENT_AND_STREAMING,description:"Actors targeting music streaming, video, gaming, book, and podcast platforms such as Spotify, IMDb, Netflix, Steam, SoundCloud, Vimeo, Bandcamp, Goodreads, Letterboxd, Deezer, Epic Games Store, Audible, and Dailymotion. Includes extracting content metadata, playlists, game listings, reviews, and media catalogs. Excludes YouTube and Twitch, which are covered under social media.",displayDescription:"Actors to find you titles, playlists, game data, and reviews from Spotify, IMDb, Netflix, Steam, and more.",icon:"movie"},GOVERNMENT_AND_PUBLIC_DATA:{metaLabelId:t.r.GOVERNMENT_AND_PUBLIC_DATA,description:"Actors targeting government portals, regulatory databases, court records, patent and trademark offices, and open data platforms such as SEC EDGAR, USPTO, SAM.gov, Congress.gov, PACER, EPA, OSHA, FDA, NOAA, Census Bureau, EU TED, CourtListener, and Data.gov. Includes extracting public records, legal filings, government contracts, regulatory data, and civic information.",displayDescription:"Actors to find you public records, legal filings, contracts, and civic data from SEC EDGAR, USPTO, Data.gov, and more.",icon:"building_bank",enhancedTitle:"Extract government & public data"},AUTOMOTIVE:{metaLabelId:t.r.AUTOMOTIVE,description:"Actors targeting car listing marketplaces, vehicle pricing databases, auto parts catalogs, and automotive data platforms such as Autotrader, AutoScout24, Cars.com, CarGurus, Carvana, Carfax, Mobile.de, TrueCar, and Edmunds. Includes extracting vehicle listings, pricing, specifications, dealer inventories, and parts catalogs from dedicated automotive platforms.",displayDescription:"Actors to find you vehicle listings, prices, specs, and parts from Autotrader, Cars.com, CarGurus, and more.",icon:"car"},CLASSIFIEDS_AND_PEER_TO_PEER:{metaLabelId:t.r.CLASSIFIEDS_AND_PEER_TO_PEER,description:"Actors targeting peer-to-peer selling platforms, local classified ad sites, and secondhand marketplaces such as Craigslist, OLX, Leboncoin, Kleinanzeigen, Vinted, Gumtree, Kijiji, Marktplaats, Mercari, OfferUp, Subito.it, Dubizzle, and Poshmark. Distinct from B2C ecommerce marketplaces — these platforms connect individuals selling directly to other individuals.",displayDescription:"Actors to find you listings and seller details from Craigslist, Vinted, Mercari, and more.",icon:"packages",enhancedTitle:"Extract classifieds & marketplace data"},DEVELOPER_AND_TECH:{metaLabelId:t.r.DEVELOPER_AND_TECH,description:"Actors targeting code hosting services, package registries, developer communities, and tech product directories such as GitHub, GitLab, Stack Overflow, npm, PyPI, Docker Hub, Product Hunt, Chrome Web Store, Dev.to, Hacker News, and Kaggle. Includes extracting repositories, packages, developer profiles, technical Q&A threads, and product listings from platforms built for software developers.",displayDescription:"Actors to find you repos, profiles, and product listings from GitHub, Stack Overflow, Product Hunt, and more.",icon:"plug",enhancedTitle:null},GENERIC_SCRAPERS:{metaLabelId:t.r.GENERIC_SCRAPERS,description:"Actors that work across any website without being tied to a specific platform. Includes general-purpose web crawlers, universal scrapers, sitemap extractors, and tools that accept arbitrary URLs as input.",displayDescription:"General-purpose Actors to scrape, crawl, and automate any website or URL.",icon:"spider",enhancedTitle:null},FACEBOOK:{metaLabelId:t.r.FACEBOOK,description:"Scrapes or interacts with Facebook.",icon:"social"},INSTAGRAM:{metaLabelId:t.r.INSTAGRAM,description:"Scrapes or interacts with Instagram.",icon:"aperture"},X_TWITTER:{metaLabelId:t.r.X_TWITTER,description:"Scrapes or interacts with X (formerly Twitter).",icon:"hash"},TIKTOK:{metaLabelId:t.r.TIKTOK,description:"Scrapes or interacts with TikTok.",icon:"music"},YOUTUBE:{metaLabelId:t.r.YOUTUBE,description:"Scrapes or interacts with YouTube.",icon:"player_play"},LINKEDIN:{metaLabelId:t.r.LINKEDIN,description:"Scrapes or interacts with LinkedIn.",icon:"linkedin"},AMAZON:{metaLabelId:t.r.AMAZON,description:"Scrapes or interacts with Amazon.",icon:"package"},EBAY:{metaLabelId:t.r.EBAY,description:"Scrapes or interacts with eBay.",icon:"receipt"},ETSY:{metaLabelId:t.r.ETSY,description:"Scrapes or interacts with Etsy.",icon:"needle_thread"},ALIEXPRESS:{metaLabelId:t.r.ALIEXPRESS,description:"Scrapes or interacts with AliExpress.",icon:"coin"},GOOGLE:{metaLabelId:t.r.GOOGLE,description:"Scrapes or interacts with Google services (Search, Maps, Shopping, News, etc.).",icon:"search"},BOOKING_COM:{metaLabelId:t.r.BOOKING_COM,description:"Scrapes or interacts with Booking.com.",icon:"bed"},TRIPADVISOR:{metaLabelId:t.r.TRIPADVISOR,description:"Scrapes or interacts with Tripadvisor.",icon:"plane_departure"},REDDIT:{metaLabelId:t.r.REDDIT,description:"Scrapes or interacts with Reddit.",icon:"alien"},YELP:{metaLabelId:t.r.YELP,description:"Scrapes or interacts with Yelp.",icon:"star_half"},ZILLOW:{metaLabelId:t.r.ZILLOW,description:"Scrapes or interacts with Zillow.",icon:"building_cottage"},GOOGLE_MAPS:{metaLabelId:t.r.GOOGLE_MAPS,description:"Scrapes or interacts with Google Maps.",icon:"map_2"},AIRBNB:{metaLabelId:t.r.AIRBNB,description:"Scrapes or interacts with Airbnb.",icon:"home_heart"},PINTEREST:{metaLabelId:t.r.PINTEREST,description:"Scrapes or interacts with Pinterest.",icon:"pin"},SHOPIFY:{metaLabelId:t.r.SHOPIFY,description:"Scrapes or interacts with Shopify.",icon:"shopping_bag"},GITHUB:{metaLabelId:t.r.GITHUB,description:"Scrapes or interacts with GitHub.",icon:"git_branch"},SNAPCHAT:{metaLabelId:t.r.SNAPCHAT,description:"Scrapes or interacts with Snapchat.",icon:"ghost"},TRUSTPILOT:{metaLabelId:t.r.TRUSTPILOT,description:"Scrapes or interacts with Trustpilot.",icon:"star_full"},TELEGRAM:{metaLabelId:t.r.TELEGRAM,description:"Scrapes or interacts with Telegram.",icon:"send"},REALTOR_COM:{metaLabelId:t.r.REALTOR_COM,description:"Scrapes or interacts with Realtor.com.",icon:"building_plus"},THREADS:{metaLabelId:t.r.THREADS,description:"Scrapes or interacts with Threads.",icon:"messages"},YELLOW_PAGES:{metaLabelId:t.r.YELLOW_PAGES,description:"Scrapes or interacts with Yellow Pages.",icon:"phone"},GLASSDOOR:{metaLabelId:t.r.GLASSDOOR,description:"Scrapes or interacts with Glassdoor.",icon:"id_badge"},INDEED:{metaLabelId:t.r.INDEED,description:"Scrapes or interacts with Indeed.",icon:"clipboard_search"},CRUNCHBASE:{metaLabelId:t.r.CRUNCHBASE,description:"Scrapes or interacts with Crunchbase.",icon:"chart_dots_2"},SPOTIFY:{metaLabelId:t.r.SPOTIFY,description:"Scrapes or interacts with Spotify.",icon:"headphones"},GOOGLE_PLAY:{metaLabelId:t.r.GOOGLE_PLAY,description:"Scrapes or interacts with Google Play.",icon:"player_play"},APPLE_APP_STORE:{metaLabelId:t.r.APPLE_APP_STORE,description:"Scrapes or interacts with the Apple App Store.",icon:"apps"},WALMART:{metaLabelId:t.r.WALMART,description:"Scrapes or interacts with Walmart.",icon:"building_store"},UPWORK:{metaLabelId:t.r.UPWORK,description:"Scrapes or interacts with Upwork.",icon:"briefcase_2"},BING:{metaLabelId:t.r.BING,description:"Scrapes or interacts with Bing.",icon:"world_search"},VK:{metaLabelId:t.r.VK,description:"Scrapes or interacts with VK (VKontakte), Russia's largest social network.",icon:"users_group"},WHATSAPP:{metaLabelId:t.r.WHATSAPP,description:"Scrapes or interacts with WhatsApp.",icon:"message_circle"},BLUESKY:{metaLabelId:t.r.BLUESKY,description:"Scrapes or interacts with Bluesky.",icon:"butterfly"},DISCORD:{metaLabelId:t.r.DISCORD,description:"Scrapes or interacts with Discord.",icon:"headset"},SUBSTACK:{metaLabelId:t.r.SUBSTACK,description:"Scrapes or interacts with Substack.",icon:"clipboard_text"},IMDB:{metaLabelId:t.r.IMDB,description:"Scrapes or interacts with IMDb (Internet Movie Database).",icon:"stars"},VIDEOS:{metaLabelId:t.r.VIDEOS,description:"Actors whose primary output is video-related data such as video URLs, metadata, thumbnails, view counts, and download links. Includes video downloaders and metadata extractors. For actors focused specifically on extracting spoken or written text from video/audio, see the Transcripts category.",icon:"player_play"},TRANSCRIPTS:{metaLabelId:t.r.TRANSCRIPTS,description:"Actors whose primary output is transcribed or captioned text derived from audio or video content. Includes subtitles, closed captions, auto-generated transcripts, podcast episode transcriptions, meeting or call transcripts, and interview recordings converted to text. Typically structured with timestamps, speaker labels, or segment markers. Distinct from the Videos category, which covers video metadata and download links rather than text content.",icon:"subtitles_edit"},PROFILES:{metaLabelId:t.r.PROFILES,description:"Actors whose primary output is user or business profile data such as names, bios, follower counts, contact information, activity history, and account metadata from social networks or directories.",icon:"person"},PLACES:{metaLabelId:t.r.PLACES,description:"Actors whose primary output is location or place data such as business names, addresses, phone numbers, opening hours, ratings, and coordinates from maps and directory platforms.",icon:"map_pins"},PRODUCTS:{metaLabelId:t.r.PRODUCTS,description:"Actors whose primary output is product data such as titles, prices, descriptions, images, availability, specifications, and seller information from e-commerce and marketplace platforms.",icon:"shopping_bag_plus"},COMMENTS:{metaLabelId:t.r.COMMENTS,description:"Actors whose primary output is user-generated comments, replies, and discussion threads from social media, forums, and community platforms. Covers casual conversational content such as post comments, nested replies, and discussion board threads. Does not include formal product or service reviews — see the Reviews category for those.",icon:"comment"},REVIEWS:{metaLabelId:t.r.REVIEWS,description:"Actors whose primary output is formal user reviews and ratings of products, services, businesses, apps, or employers. Includes star ratings, written review text, reviewer metadata, helpfulness votes, and verified purchase flags from platforms such as Amazon, Trustpilot, Yelp, Google Reviews, App Store, Play Store, G2, Capterra, Tripadvisor, and Glassdoor. Distinct from Comments, which covers casual discussion rather than structured review content.",icon:"thumbs_up"},CONTACT_DETAILS:{metaLabelId:t.r.CONTACT_DETAILS,description:"Email addresses, phone numbers, names, and other contact information extracted from websites, directories, or platforms. Typically includes structured fields like email, phone, full name, job title, company, and LinkedIn URL. Produced by lead generation tools, email finders, contact scrapers, and business directory extractors.",icon:"email"},REAL_ESTATE_LISTINGS:{metaLabelId:t.r.REAL_ESTATE_LISTINGS,description:"Property and rental listing data including addresses, listing prices or rents, square footage, bedroom/bathroom counts, property type, amenities, photos, agent or agency info, and listing URLs. Produced by scrapers targeting real estate portals, rental platforms, and property aggregators.",icon:"door"},JOB_LISTINGS:{metaLabelId:t.r.JOB_LISTINGS,description:"Job posting data including job titles, company names, locations, salary ranges, employment types, experience requirements, skill tags, job descriptions, posting dates, and application URLs. Produced by scrapers targeting job boards, career pages, and professional networks.",icon:"people"},SOCIAL_POSTS:{metaLabelId:t.r.SOCIAL_POSTS,description:"Original social media posts, stories, reels, and feed content including text/captions, media URLs (images, videos), engagement metrics (likes, shares, views), timestamps, hashtags, and author information. Produced by scrapers targeting social media feeds, user timelines, and hashtag/topic searches.",icon:"photo_video"},FINANCIAL_DATA:{metaLabelId:t.r.FINANCIAL_DATA,description:"Financial market data including stock prices, cryptocurrency token data, exchange rates, trading volumes, market capitalization, historical price charts, dividend info, and investment metrics. Produced by scrapers targeting stock exchanges, crypto platforms, forex sites, and financial data aggregators.",icon:"report_money"},COMPANY_DATA:{metaLabelId:t.r.COMPANY_DATA,description:"Business entity data including company names, industries, headquarters locations, employee counts, revenue figures, founding years, funding rounds, key personnel, and registration details. Produced by scrapers targeting business directories, company databases, registries, and B2B intelligence platforms.",icon:"clipboard_data"},NEWS_ARTICLES:{metaLabelId:t.r.NEWS_ARTICLES,description:"News articles, blog posts, press releases, and editorial content including headlines, body text, author names, publication dates, source outlets, article categories, and featured images. Produced by scrapers targeting news sites, content aggregators, RSS feeds, and media outlets.",icon:"article"},SEO_ANALYTICS:{metaLabelId:t.r.SEO_ANALYTICS,description:"Search engine optimization metrics and web analytics data including domain authority scores, backlink profiles, keyword difficulty ratings, search volume estimates, traffic analytics, ranking histories, and competitor analysis metrics. Produced by SEO audit tools, backlink analyzers, keyword research scrapers, and web traffic estimators.",icon:"analytics"},EVENTS:{metaLabelId:t.r.EVENTS,description:"Event listing data including event names, dates and times, venue names and addresses, ticket prices, organizer details, event descriptions, categories, and attendee or capacity information. Produced by scrapers targeting event platforms, ticketing sites, conference directories, and community calendars.",icon:"ticket"},SEARCH_RESULTS:{metaLabelId:t.r.SEARCH_RESULTS,description:"Search engine results page (SERP) data including ranked URLs, page titles, meta descriptions, snippet text, featured snippets, knowledge panel data, related queries, and position rankings. Produced by SERP scrapers, keyword rank trackers, and search engine data extractors.",icon:"list_search"},OPEN_SOURCE:{metaLabelId:t.r.OPEN_SOURCE,description:"The Actor's source code is publicly available in a repository (e.g. GitHub). Apply this label when the actor explicitly states it is open source or links to a public repository.",icon:"lock"},AGENT:{metaLabelId:t.r.AGENT,description:'The Actor IS itself an autonomous AI agent — it uses an LLM to reason over a goal, plan multi-step actions, and decide what to do next without step-by-step human instructions. Key test: does the actor contain LLM-driven decision-making at its core, or is it just a scraper/tool that an external agent might call? DO NOT assign if: the actor merely scrapes an agent platform (n8n, Zapier, Make, LangChain, AutoGPT, etc.); the readme mentions "agent" only as a downstream consumer of the data; or the actor is a deterministic scraper with no LLM reasoning inside it.',exemplarIds:["AEIpBIIzlKDhENIHi","2ROTHRYbnplnLOE7O","dLXH5Ia8gLsNjieKV"],icon:"robot_face"},AUTOMATION:{metaLabelId:t.r.AUTOMATION,description:'The Actor performs WRITE actions or executes workflows on behalf of the user — such as submitting forms, posting content, sending messages, managing accounts, clicking through flows, or operating bots that interact with platforms. Key test: does the actor DO things (write, submit, send, interact) — or does it only READ and extract data? DO NOT assign to actors that only scrape or download data, even if they run on a schedule or are "automated" in the general sense. Apify is an automation platform — simply running on Apify does not qualify an actor for this label. The actor must actively take actions in the world, not just observe it.',exemplarIds:["Uk8ZlE4NVYccUvpHw","PhhdBj3ymmqKudn9R","f4DM1wGmMQdnTLbrE"],icon:"analyze"},INTEGRATION:{metaLabelId:t.r.INTEGRATION,description:'The Actor\'s PRIMARY purpose is to move or sync data BETWEEN systems — it is the glue, not the data source. This means: (1) it pushes or syncs data TO an external service (CRM, database, spreadsheet, webhook, Slack, Notion, etc.); or (2) it is explicitly designed to accept another actor\'s dataset as input and process or forward it. Key test: does the actor MOVE data between two existing systems, or does it produce new data for the user? DO NOT assign if: the actor calls an external API merely to fetch or enrich data — wrapping a third-party API (e.g. Tomba, Hunter, Clearbit, OpenAI) to retrieve results is data enrichment, not integration; the actor\'s readme mentions "CRM integration" or "database import" only as a downstream use case for its output — that describes what the user does with the data, not what the actor does; or the actor is a regular scraper whose data could theoretically be piped somewhere.',exemplarIds:["5bOWSIsdbIyA6X7F4","e643gqfZae2TfQEbA","Tk8jMt4ehWhJzpn6N","FWdvK8wduoktWgTJp"],icon:"webhook"},MCP_SERVER:{metaLabelId:t.r.MCP_SERVER,description:"The Actor exposes a Model Context Protocol (MCP) server endpoint, allowing AI assistants and LLM applications to call it as a tool. Apply when the actor explicitly advertises MCP support or is designed to be consumed by AI agents via the MCP standard.",exemplarIds:["BEwUoGEsRUQC2iUPa","bNLFHqgWro6XnB9h7"],icon:"mcp"},AI_TOOLS:{metaLabelId:t.r.AI_TOOLS,description:"The Actor is purpose-built specifically for AI/LLM developer workflows — its primary audience is developers building AI applications, not end users who want data. Applies to: actors that explicitly serve as a data source for LLMs (web search/crawl for AI), prepare training corpora or fine-tuning datasets, chunk and embed content for RAG pipelines, or are designed as tools for AI agents. Key test: would an AI developer seek this actor specifically because they are building an AI application? DO NOT assign just because scraped data could theoretically be used to train a model — that applies to virtually every scraper on the platform and makes the label meaningless. The AI use case must be the explicit, primary purpose.",icon:"box_ai"}},s=e=>({...e,...i[e.id]}),r=a.G.map(s),n=a.$.map(s),o=a.v.map(s),c=a.x.map(s),d=a.c.map(s),l=[...r,...d,...n,...o,...c];new Map(r.map(e=>[e.id,e]));let p=new Map(l.map(e=>[e.id,e]));new Map(l.map(e=>[e.metaLabelId,e])),new Set(l.map(e=>e.metaLabelId));let m=new Set([a.A.OPEN_SOURCE]);new Set(l.filter(e=>!m.has(e.id)).map(e=>e.metaLabelId)),e.s(["h",0,p,"v",0,o,"$",0,n,"c",0,d,"x",0,c,"C",0,e=>e===a.A.OTHER])}]);

//# debugId=47c05952-c14c-bb85-9a2d-675b20660e09