        position: relative;
        display: flex;
        flex: 1;
        min-width: 0;
        height: 5rem;
        overflow: hidden;
        border: 1px solid ${k.f.color.neutral.border};
        border-radius: ${k.f.radius.radius8};
    }

    .${H} {
        display: flex;
        flex: 0 0 auto;
        width: max-content;
        background: ${k.f.color.neutral.backgroundSubtle};

        .${P.R.WRAPPER} {
            display: flex;
            width: max-content;
            height: 100%;
        }

        .${P.R.BASE} {
            display: flex;
            width: max-content;
            height: 100%;
            align-items: center;
            gap: ${k.f.space.space8};
            padding: ${k.f.space.space8};
            border: 0;
            border-radius: 0;
            background: transparent;

            &:hover {
                background: transparent;
            }
        }

        .${S.a.OPTION_CONTENT} {
            white-space: nowrap;
        }
    }

    .${D} {
        width: 1.6rem;
        height: 1.6rem;
        flex: 0 0 1.6rem;
        object-fit: contain;
    }

    .${z} {
        position: relative;
        display: flex;
        flex: 1;
        min-width: 0;
        align-items: center;
        justify-content: space-between;
        padding: 0 ${k.f.space.space8};
        background: ${k.f.color.neutral.background};

        /* Fade sits on the code area so it stays put while the command scrolls underneath. */
        &::after {
            content: '';
            position: absolute;
            top: 0;
            right: calc(${k.f.space.space8} + 2.8rem);
            width: 2.4rem;
            height: 100%;
            background: linear-gradient(to right, transparent, ${k.f.color.neutral.background});
            pointer-events: none;
        }
    }

    /* GlobalStyles turns every inline <code> into a bordered chip, which this one is not.
       Long commands scroll under the right-edge fade; tabindex keeps the tail reachable by keyboard. */
    .${B} {
        display: flex;
        flex: 1;
        min-width: 0;
        align-items: center;
        padding: 0 ${k.f.space.space12} 0 ${k.f.space.space4};
        border: 0;
        border-radius: 0;
        background: transparent;
        color: ${k.f.color.neutral.text};
        white-space: nowrap;
        overflow-x: auto;
        scrollbar-width: none;

