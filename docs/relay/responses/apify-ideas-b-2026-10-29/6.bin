    inset: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    background: rgba(0, 0, 0, 0.5);
    transition: all ${m.f.transition.smoothEaseIn};
    z-index: 100;

    @media ${m.f.device.tablet} {
        padding: 10rem;
    }

    .${g.CLOSE} {
        top: 1rem;
        right: 1rem;
        z-index: 10;
        color: white;
        cursor: pointer;
        filter: drop-shadow(0px 0px 3px rgba(0, 27, 91, 1));
        position: absolute;
        transition: transform ${m.f.transition.smoothEaseIn};

        &:hover {
            transform: rotate(180deg);
        }
    }

    .${g.VIDEO_CONTAINER} {
        width: 100%;
        max-width: 150rem;
        height: 0;
        padding-bottom: 56.25%;
        background: black;
        box-shadow:
            0 0 2.4rem 0 rgba(0, 25, 90, 0.3),
            0 0 1.4rem 0 rgba(0, 27, 91, 0.3);
        overflow: hidden;
        position: relative;
        transition: transform ${m.f.transition.smoothEaseIn};

        /* Adjust the video height to account for wide aspect ratios */
        @media screen and (max-height: 56vw) {
            /* stylelint-disable unit-disallowed-list -- pre-existing; svh here would change mobile layout */
            width: calc((100vh - 11rem) * 16 / 9);
            height: calc(100vh - 11rem);
            /* stylelint-enable unit-disallowed-list */
            padding-bottom: 0;
        }

        .${g.VIDEO_PLAYER} {
            top: 0;
            left: 0px;
            position: absolute;
            width: 100%;

            &:hover {
                & + .${g.ACTIONS} {
                    opacity: 1;
                    pointer-events: auto;
                }
