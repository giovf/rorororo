    & > :not([aria-hidden]) {
        flex: 1;
    }

    /* Diagonal highlight sweeping across the button - width is relative so it scales to any button */
    &::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
