    padding-right: ${k.f.space.space16};
    padding-left: ${k.f.space.space16};

    .HeroSection-gridContainer {
        /* Section spacing - paddings */
        padding-top: calc(${l.R} + 8rem);
        padding-bottom: ${k.f.space.space40};
        max-width: 1200px; /* Max width of the section */

        /* Centering the section */
        margin-left: auto;
        margin-right: auto;

        /* Positioning and text styling */
        white-space: break-spaces;
        position: relative;

        &.vertical {
            text-align: center;
        }
    }

    /* Back button at the top of the section */
    .HeroSection-backButton {
        position: absolute;
        width: 100%;
        top: -4.6rem;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        white-space: nowrap;
        margin-bottom: ${k.f.space.space16};
        padding-right: 4px;
        a {
            width: fit-content;
        }
    }

    .HeroSection-backButton.vertical {
        justify-content: center;
    }

    /* Promotion label and content */
    .HeroSection-promotion {
        margin-bottom: ${k.f.space.space32};
    }

    /* Title - H1 */
    h1 {
        margin-top: 0;
        margin-bottom: ${k.f.space.space16};
        /* Gradient text removed. The enhancedTitleSubstring still wraps part of the title
           in a <span> (renders as plain text now).
           TODO: remove the span wrapping entirely, plus the enhancedTitleSubstring field
           from Strapi and this codebase. */
    }

    /* Text area styling */
    .HeroSection-textArea {
        &.horizontal {
            text-align: left;
        }
    }

    /* Text from Strapi styling - markdown so there are more styling needed */
    .HeroSection-strapiDescription {
        display: flex;
        flex-direction: column;
        white-space: break-spaces;
        p:not(:last-child) {
            margin-bottom: ${k.f.space.space16};
        }
    }

    .HeroSection-description,
    .HeroSection-strapiDescription {
        color: ${k.f.color.neutral.textMuted};
    }

    /* Image styling */
    .HeroSection-illustration {
        margin-top: ${({$layout:e})=>e===eo?"0":"3.2rem"};
        width: 100%;
    }

    .HeroSection-mediaArea {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Actions styling */
    .HeroSection-heroLinks {
        display: flex;
        flex-wrap: wrap;
        column-gap: ${({$layout:e})=>e===eo?k.f.space.space40:k.f.space.space16};
        row-gap: ${k.f.space.space16};
        margin-top: ${k.f.space.space24};
        width: 100%;
        justify-content: ${({$layout:e})=>e===eo?"flex-start":"center"};
        align-items: center;

        .HeroSection-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: ${k.f.space.space16};
            width: 100%;
            justify-content: ${({$layout:e})=>e===eo?"flex-start":"center"};

            @media ${k.f.device.tablet} {
                ${({$layout:e})=>e===eo&&$.m`
                        width: auto;
                    `}
            }

            > a {
                width: 100%;

                @media ${k.f.device.tablet} {
                    width: auto;
                    min-width: 24rem;
                }
            }

            &.HeroSection-buttons--with-install-picker {
                width: 100%;

                .InstallCommandPicker {
                    flex: 1 1 100%;
                    width: 100%;
                    min-width: 0;
                }
            }
        }

        .HeroSection-ratingBadges {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: ${k.f.space.space24};
            width: 100%;
            ${({$layout:e})=>e!==eo&&$.m`
                    justify-content: center;
                `}

            @media ${k.f.device.tablet} {
                flex-direction: row;
                ${({$layout:e})=>e===eo&&$.m`
                        width: auto;
                    `}
            }
        }
    }

    /* Grid gaps */
    .HeroSection-gap {
        display: none;
    }

    /* TABLET */
