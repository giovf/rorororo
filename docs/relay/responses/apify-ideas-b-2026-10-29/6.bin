    min-width: 0;
    max-width: 100%;
    display: inline-flex;
    flex-direction: row;
    height: 4rem;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: ${c.f.space.space6};
    padding: ${c.f.space.space8} ${c.f.space.space12};
    border: 1px solid ${c.f.color.neutral.separatorSubtle};
    border-radius: ${c.f.radius.radiusFull};
    background-color: ${c.f.color.neutral.cardBackground};
    text-decoration: none;
    transition: background-color ${c.f.transition.smoothEaseOut};
    overflow: hidden;

    &.Promotion--shine {
        border-color: transparent;
        background:
            linear-gradient(${c.f.color.neutral.cardBackground}, ${c.f.color.neutral.cardBackground}) padding-box,
            linear-gradient(90deg, #1672eb, #b2c6ff, #d8e2ff, #b2c6ff, #1672eb) border-box;
        background-size:
            100% 100%,
            200% 100%;
        animation: shine 3s linear infinite;
    }

    @keyframes shine {
        0% {
            background-position:
                0 0,
                0 0;
        }
        100% {
            background-position:
                0 0,
                200% 0;
        }
    }

    & > * {
        align-self: center;
        text-align: center;
        text-decoration: none;
    }

    &:hover {
        background-color: ${c.f.color.neutral.hover};
        text-decoration: none;
        .Promotion-arrow {
            transform: translateX(4px);
        }
    }

    .Promotion-label {
        max-width: 50%;
        flex-shrink: 0;
        padding: ${c.f.space.space2} ${c.f.space.space8};
        border-radius: ${c.f.radius.radius12};
        background-color: ${c.f.color.primary.background};
        color: ${c.f.color.primary.chipText};
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-right: ${c.f.space.space2};
    }

    .Promotion-content {
        flex-shrink: 1;
        color: ${c.f.color.neutral.text};
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        * {
            font-size: inherit;
            line-height: inherit;
        }
    }

    .Promotion-arrow {
        flex-shrink: 0;
        vertical-align: sub;
        color: ${c.f.color.neutral.text};
        transition: transform ${c.f.transition.smoothEaseOut};
    }
`,p="Promotion__pill--desktop",u="Promotion__pill--mobile",m=l.U.div.withConfig({displayName:"Promotion__ResponsiveWrapper",componentId:"sc-e9cd7dbd-1"})`
    width: 100%;
    margin-block: ${c.f.space.space16};
    text-align: center;

    /* Lift the pill into its own stacking context so overlapping siblings (e.g. the store
       hero's non-positioned animated canvas logo, which renders after this pill in the DOM)
       don't paint over its right edge. No-op when there's nothing to overlap. */
    position: relative;
    z-index: 3;

    .${p} {
        display: none;
    }

    @media ${c.f.device.tablet} {
        .${u} {
            display: none;
        }

        .${p} {
            display: inline-flex;
        }
    }
