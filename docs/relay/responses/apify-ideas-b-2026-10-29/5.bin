    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    position: relative;
    box-sizing: border-box;
    transition:
        border-color 120ms ease-out,
        background-color 120ms ease-out !important;

    &:hover,
    &:focus {
        border-color: ${T.f.color.primary.action};
        cursor: pointer;
    }

    &.disabled {
        background-color: ${T.f.color.neutral.textDisabled};
        border-color: ${T.f.color.neutral.border};
    }

    &.error {
        border-color: ${T.f.color.danger.text};
    }

    &[data-state='indeterminate'],
    &[data-state='checked'] {
        background-color: ${T.f.color.primary.action};
        border-color: ${T.f.color.primary.action};

        &:hover {
            background-color: ${T.f.color.primary.actionHover};
            border-color: ${T.f.color.primary.actionHover};
        }

        &.error {
            background-color: ${T.f.color.danger.action};
            border-color: ${T.f.color.danger.action};

            &:hover {
                background-color: ${T.f.color.danger.actionHover};
                border-color: ${T.f.color.danger.actionHover};
            }
        }

        &.disabled {
            background-color: ${T.f.color.neutral.textDisabled};
            border-color: ${T.f.color.neutral.border};
        }
    }
