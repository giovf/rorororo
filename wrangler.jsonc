{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faceless-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "vars": {
    // Safe by default: deploys (which read these vars) get "false", so a real
    // origin outage surfaces as a 503 / refresh_log error instead of silently
    // serving bundled fixtures as live data. Local dev opts in via .dev.vars
    // (which overrides this), and tests set it in vitest.config.ts.
    "FIXTURE_FALLBACK": "false"
  },
  // Placeholder ids: local dev + tests run on miniflare simulations and never
  // contact Cloudflare; replace with real ids (wrangler d1/kv namespace create)
  // before the first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faceless-api",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "cache-placeholder-id" },
    { "binding": "RATE", "id": "rate-placeholder-id" }
  ],
  "assets": {
    "directory": "public"
  },
  "triggers": {
    // Daily source refresh; per-source cadence is dispatched in code (task 3).
    "crons": ["0 5 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
