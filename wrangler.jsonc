{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faceless-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  // Node built-ins (Buffer, etc.) — needed by the Coinbase CDP x402 facilitator.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Safe by default: deploys (which read these vars) get "false", so a real
    // origin outage surfaces as a 503 / refresh_log error instead of silently
    // serving bundled fixtures as live data. Local dev opts in via .dev.vars
    // (which overrides this), and tests set it in vitest.config.ts.
    "FIXTURE_FALLBACK": "false"
  },
  // Real resource ids (not secrets — safe to commit). Local dev + tests still
  // run on miniflare simulations and never touch these.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faceless-api",
      "database_id": "ac051277-5f69-46ba-965b-50da2f1ec524"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "eacc87d970e94b9b87ce944985af0b52" },
    { "binding": "RATE", "id": "de75231f2c994f68b003d414be100759" }
  ],
  "assets": {
    "directory": "public"
  },
  "triggers": {
    // Daily source refresh; per-source cadence is dispatched in code (task 3).
    "crons": ["0 5 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
