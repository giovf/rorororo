# Copy to `.dev.vars` (gitignored) for local wrangler dev. Production values
# are set with `wrangler secret put <KEY>` — never committed, never in .env
# (that file is for CLI tooling only, per CLAUDE.md).

# Guards the operator endpoints (e.g. DELETE /v1/keys/:id).
# Generate one: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token

# Stripe (test mode; billing endpoints 503 until set — see docs/STRIPE-SETUP.md).
# Keep the empty defaults if you're not working on billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# x402 agent payments — ALL routes under /x402 stay dark (404) until a wallet
# is set. See docs/X402-SETUP.md. Keep empty defaults unless working on x402.
X402_WALLET_ADDRESS=
X402_PRICE_USD=
X402_NETWORK=
X402_FACILITATOR_URL=
