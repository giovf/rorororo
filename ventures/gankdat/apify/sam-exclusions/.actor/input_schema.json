{
  "title": "US Federal Exclusions (SAM.gov) \u2014 debarment list \u2014 filters",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "name": {
      "title": "Name contains",
      "type": "string",
      "description": "Filter: Name contains (case-insensitive substring match).",
      "editor": "textfield"
    },
    "classification": {
      "title": "Classification",
      "type": "string",
      "description": "Individual, Firm, Special Entity Designation, Vessel",
      "editor": "textfield"
    },
    "excluding_agency": {
      "title": "Excluding agency contains",
      "type": "string",
      "description": "e.g. HHS, OFAC, OPM, DOJ",
      "editor": "textfield"
    },
    "exclusion_program": {
      "title": "Exclusion program contains",
      "type": "string",
      "description": "Reciprocal, Procurement, Nonprocurement",
      "editor": "textfield"
    },
    "activation_date_after": {
      "title": "Activated on or after",
      "type": "string",
      "description": "YYYY-MM-DD",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "q": {
      "title": "Free-text search",
      "type": "string",
      "description": "Filter: Free-text search (case-insensitive substring match).",
      "editor": "textfield"
    },
    "max_results": {
      "title": "Maximum results",
      "type": "integer",
      "description": "Stop after this many records (you are charged per result).",
      "default": 1000,
      "minimum": 1,
      "maximum": 100000
    }
  },
  "required": []
}
