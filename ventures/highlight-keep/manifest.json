{
  "manifest_version": 3,
  "name": "Highlight Keep — Web Highlighter & Notes, Private",
  "short_name": "Highlight Keep",
  "version": "0.1.0",
  "description": "Highlight any page, add notes, find it all again. Stored in your browser, no account, exports to Markdown.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Highlight Keep" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "library.html",
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+H", "mac": "MacCtrl+Shift+H" },
      "description": "Turn Highlight Keep on/off for this site"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
