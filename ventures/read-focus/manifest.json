{
  "manifest_version": 3,
  "name": "ReadFocus \u2014 Focus Reading: Bold Word Starts, Reading Ruler & Dyslexia Fonts",
  "short_name": "ReadFocus",
  "version": "0.1.0",
  "description": "Bold word starts, a reading ruler, text size, paragraph focus and dyslexia fonts. Private: nothing leaves your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReadFocus"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "MacCtrl+Shift+F"
      },
      "description": "Toggle ReadFocus on this site"
    },
    "toggle-ruler": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Toggle the reading ruler"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
